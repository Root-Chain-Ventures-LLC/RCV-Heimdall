# Copy to .env and edit. .env is never committed.

# REQUIRED. Seals session cookies and encrypts the credentials of integrations (for example a
# Seshat API token). At least 32 characters of random data:
#   openssl rand -base64 48
# Changing it later signs everyone out and makes stored integration tokens unreadable; an
# administrator enters them again under Settings, Integrations.
HEIMDALL_SECRET_KEY=

# REQUIRED. Password of the bundled PostgreSQL. Letters and digits only:
#   openssl rand -hex 16
POSTGRES_PASSWORD=

# The address people type into the browser. State-changing requests must carry exactly this
# origin, and an https:// address turns on the Secure cookie flag.
BASE_URL=http://localhost:8080

# First-run setup token. Empty: a random one is printed once in the log (docker compose logs heimdall).
HEIMDALL_SETUP_TOKEN=

# Behind a reverse proxy, set this to the proxy's address (or a comma-separated list of proxy
# addresses or CIDR prefixes; 1 means one proxy on a private address). Heimdall then takes each
# visitor's address from X-Forwarded-For. Left empty, every visitor looks like the proxy, so all
# users share one sign-in rate-limit bucket and a few wrong guesses block everyone. Without a
# proxy, leave it empty: nothing is trusted.
TRUST_PROXY=

# compose publishes the web port on the loopback interface only (plain HTTP). Set one private
# address to publish there instead.
# HEIMDALL_PUBLISH_ADDR=127.0.0.1
